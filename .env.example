# DiagnoBot local development configuration
APP_NAME=DiagnoBot
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MOCK_MODE=true

# Local development database
DATABASE_URL=sqlite+aiosqlite:///./diagnobot.db

# Model and runtime settings
USE_GPU=false
DEVICE=cpu
MODEL_CACHE_DIR=./models_cache
CPU_THREADS=4
REASONING_MAX_TOKENS=96
VISION_MAX_TOKENS=80
VISION_MODEL_BACKEND=moondream_gguf

# Uploads and logs
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=50
MAX_FILE_SIZE_MB=100
LOG_FILE=./logs/diagnobot.log

# Browser origins; keep restricted to the frontend origins you actually use.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]

# Local-only development defaults
API_KEY_ENABLED=false
API_KEYS=[]
