# ==================== APP CONFIG ====================\nAPP_NAME=DiagnoBot\nENVIRONMENT=development\nHOST=0.0.0.0\nPORT=8000\nLOG_LEVEL=INFO\n\n# ==================== DATABASE ====================\n# PostgreSQL (Production)\nDATABASE_URL=postgresql://diagnobot:diagnobot@localhost:5432/diagnobot\n\n# SQLite (Development)\n# DATABASE_URL=sqlite:///./diagnobot.db\n\n# ==================== REDIS ====================\nREDIS_URL=redis://localhost:6379/0\nENABLE_CACHE=true\nCACHE_TTL_SECONDS=3600\n\n# ==================== ML MODELS ====================\nUSE_GPU=true\nDEVICE=cuda\nMODEL_CACHE_DIR=./models_cache\n\n# Model revisions\nMOONDREAM2_REVISION=2025-06-21\nCLINICAL_BERT_MODEL=emilyalsentzer/Bio_ClinicalBERT\nBIOGPT_MODEL=microsoft/biogpt\nBIOBART_MODEL=GanjinZero/biobart-base\nCLINICAL_T5_MODEL=luqh/ClinicalT5-large\nDERM_CNN_MODEL=iamhmh/derm-cnn-ham10000\n\n# ==================== FILE UPLOAD ====================\nMAX_IMAGE_SIZE_MB=50\nMAX_FILE_SIZE_MB=100\nUPLOAD_DIR=./uploads\n\n# ==================== WEBCAM ====================\nWEBCAM_ENABLED=true\nWEBCAM_DEVICE_ID=0\nWEBCAM_RESOLUTION=640,480\nWEBCAM_FPS=30\n\n# ==================== INFERENCE TIMEOUTS ====================\nXRAY_INFERENCE_TIMEOUT=30\nDERMATOLOGY_INFERENCE_TIMEOUT=20\nNLP_INFERENCE_TIMEOUT=25\n\n# ==================== CORS ====================\nCORS_ORIGINS=[\"http://localhost:3000\",\"http://localhost:8080\",\"http://127.0.0.1:3000\"]\n\n# ==================== API KEYS ====================\nAPI_KEY_ENABLED=false\nAPI_KEYS=[]\n\n# ==================== LOGGING ====================\nLOG_FILE=./logs/diagnobot.log\n